{
  "name": "arandue",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "demo:setup": "node scripts/setup-demo.mjs",
    "test": "npm test -w backend",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p packages/shared && tsc -p backend && tsc -p frontend && tsc -p e2e",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@sentry/esbuild-plugin": "11.11.0",
    "@types/node": "26.6.6",
    "concurrently": "^10.0.7",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
