# Copie para backend/.env (o .env nunca vai para o Git).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://arandue:arandue@127.0.0.1:5432/arandue
# Banco usado pelo `npm test` (criado automaticamente pelo compose).
TEST_DATABASE_URL=postgres://arandue:arandue@127.0.0.1:5432/arandue_test
# Origens autorizadas a fazer requisições que alteram dados (separadas por vírgula).
ALLOWED_ORIGINS=http://localhost:5173
# Assistente de IA. Sem chave, use AI_PROVIDER=fake para respostas de teste.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=fake
# Bot do Telegram: token do @BotFather e um segredo qualquer (16+ letras, números, _ ou -).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
