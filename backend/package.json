{
  "name": "@arandue/backend",
  "private": true,
  "license": "MIT",
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "telegram": "node --env-file-if-exists=.env src/telegramCli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@arandue/shared": "*",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@node-rs/argon2": "2.2.2",
    "@sentry/node": "11.11.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "grammy": "1.46.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0"
  }
}
